{
  "ci": {
    "collect": {
      "startServerCommand": "yarn preview --port 4173",
      "startServerReadyPattern": "Local:",
      "url": ["http://localhost:4173/", "http://localhost:4173/es/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.95}],
        "categories:accessibility": ["error", {"minScore": 1}],
        "categories:best-practices": ["error", {"minScore": 1}],
        "categories:seo": ["error", {"minScore": 1}],

        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.05}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2000}],
        "first-contentful-paint": ["error", {"maxNumericValue": 1800}],
        "speed-index": ["error", {"maxNumericValue": 1800}],
        "total-blocking-time": ["error", {"maxNumericValue": 200}],

        "modern-image-formats": ["error", {"maxNumericValue": 0}],
        "uses-responsive-images": ["error", {"maxNumericValue": 0}],
        "uses-text-compression": ["error", {"maxNumericValue": 0}],

        "resource-summary:script:size": ["error", {"maxNumericValue": 95000}],
        "resource-summary:image:size": ["error", {"maxNumericValue": 30000}],
        "resource-summary:total:size": ["error", {"maxNumericValue": 140000}],
        "resource-summary:third-party:count": ["warn", {"maxNumericValue": 0}],

        "unused-javascript": ["warn", {"maxNumericValue": 40000}],
        "render-blocking-resources": ["warn", {"maxNumericValue": 200}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
