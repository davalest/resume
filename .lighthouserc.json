{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview",
      "startServerReadyPattern": "localhost",
      "url": ["http://localhost:4173/", "http://localhost:4173/es/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 1}],
        "categories:accessibility": ["error", {"minScore": 1}],
        "categories:best-practices": ["error", {"minScore": 1}],
        "categories:seo": ["error", {"minScore": 1}],

        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.01}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 1800}],
        "first-contentful-paint": ["error", {"maxNumericValue": 1500}],
        "speed-index": ["error", {"maxNumericValue": 1500}],
        "total-blocking-time": ["error", {"maxNumericValue": 50}],

        "modern-image-formats": ["error", {"maxNumericValue": 0}],
        "uses-responsive-images": ["error", {"maxNumericValue": 0}],
        "uses-text-compression": ["error", {"maxNumericValue": 0}],

        "resource-summary:script:size": ["error", {"maxNumericValue": 12000}],
        "resource-summary:image:size": ["error", {"maxNumericValue": 30000}],
        "resource-summary:total:size": ["error", {"maxNumericValue": 90000}],
        "resource-summary:third-party:count": ["error", {"maxNumericValue": 0}],

        "unused-javascript": ["error", {"maxNumericValue": 4000}],
        "render-blocking-resources": ["warn", {"maxNumericValue": 200}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
