---
import SectionLabel from "../ui/SectionLabel.astro";
import ExternalLink from "../ui/ExternalLink.astro";
import {sectionIds, sectionTitleId} from "../../utils/navigation.ts";
import {useTranslations, type SupportedLanguage} from "../../utils/i18n.ts";

interface Props {
    lang: SupportedLanguage;
}

const {lang} = Astro.props;
const {t} = useTranslations(lang);

const REPO = "https://github.com/davalest/resume";
---

<section class="section" id={sectionIds.about} aria-labelledby={sectionTitleId(sectionIds.about)}>
    <SectionLabel id={sectionIds.about} label={t("about.title")} />

    <div class="section-body about-body">
        <p>{t("about.p1")}</p>
        <p>{t("about.p2")}</p>
        <p>
            {`${t("about.p3")} `}
            <ExternalLink href={REPO} lang={lang} class="about-repo-link"
            >github.com/davalest/resume</ExternalLink
            >
        </p>
    </div>
</section>
