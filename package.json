{
  "name": "resume",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.10.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview stop > /dev/null 2>&1; astro preview --port 4173",
    "typecheck": "astro check",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.{scss,css}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "verify": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "build:pages": "GITHUB_PAGES=true astro build --outDir dist-pages",
    "verify:build": "node --experimental-strip-types scripts/verify-build.ts",
    "check:pages": "npm run typecheck && npm run build:pages && npm run verify:build",
    "postlhci": "astro preview stop > /dev/null 2>&1 || true",
    "assets:social": "node --experimental-strip-types scripts/generate-social-assets.ts"
  },
  "dependencies": {
    "@davalest/konamize": "^1.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4",
    "astro": "^7.2.9",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^9",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.103.1",
    "stylelint": "^17",
    "stylelint-config-standard-scss": "^17",
    "typescript": "^5.9",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4"
  }
}
