{
  "printWidth": 100,
  "tabWidth": 4,
  "singleQuote": false,
  "bracketSpacing": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": ["*.astro"],
      "options": {"parser": "astro"}
    },
    {
      "files": ["*.html", "*.scss", "*.css", "*.json", "*.yml", "*.yaml", "*.md", "*.webmanifest"],
      "options": {"tabWidth": 2}
    }
  ]
}
